# Chave de assinatura do token de sessão. Obrigatória em produção.
# Gere com: openssl rand -base64 48
AUTH_SECRET=

# true  → "E-mail não encontrado" / "Senha incorreta" (mensagens distintas)
# false → "E-mail ou senha incorretos" nos dois casos (sem enumeração de contas)
# Ver docs/API.md §6.
REVEAL_ACCOUNT_EXISTENCE=true

# Endereço público do site. Usado por metadataBase (Open Graph), sitemap.xml e
# robots.txt — sem ele as imagens de compartilhamento saem com URL relativa e
# nenhum leitor de link resolve. Na Vercel, VERCEL_PROJECT_PRODUCTION_URL cobre
# o caso comum; defina esta só para domínio próprio. Ver lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────── SQL Server ───────────────────────────────
# As QUATRO primeiras juntas ligam o banco. Faltando qualquer uma, o site usa
# o armazenamento em memória — que some a cada instância e NÃO serve em
# produção. Ver docs/BANCO.md.
#
# Azure SQL: o host é <servidor>.database.windows.net e o usuário NÃO leva o
# sufixo "@<servidor>" quando se usa o driver tedious.
SQLSERVER_HOST=
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# Opcionais — os valores abaixo são os padrões do código.
# SQLSERVER_PORT=1433
#
# Máximo de conexões POR INSTÂNCIA da função, não no total. Serverless escala
# horizontalmente: 20 instâncias com 4 já são 80 conexões pedidas ao servidor.
# Suba com conta, olhando o limite do seu tier.
# SQLSERVER_POOL_MAX=4
# SQLSERVER_POOL_IDLE_MS=30000
# SQLSERVER_CONNECT_TIMEOUT_MS=15000
# SQLSERVER_REQUEST_TIMEOUT_MS=15000
#
# TLS. Deixe ligado: sem ele a senha do banco trafega em claro.
# SQLSERVER_ENCRYPT=true
#
# ⚠️ Só para SQL Server local com certificado autoassinado. Ligado em produção,
# o TLS deixa de proteger contra intermediário — a conexão continua cifrada,
# mas com quem quer que atenda no caminho.
# SQLSERVER_TRUST_SERVER_CERTIFICATE=false
