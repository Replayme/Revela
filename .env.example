# Chave de assinatura do token de sessão. Obrigatória em produção.
# Gere com: openssl rand -base64 48
AUTH_SECRET=

# true  → "E-mail não encontrado" / "Senha incorreta" (mensagens distintas)
# false → "E-mail ou senha incorretos" nos dois casos (sem enumeração de contas)
# Ver docs/API.md §6.
REVEAL_ACCOUNT_EXISTENCE=true

# Endereço público do site. Usado por metadataBase (Open Graph), sitemap.xml e
# robots.txt — sem ele as imagens de compartilhamento saem com URL relativa e
# nenhum leitor de link resolve. Na Vercel, VERCEL_PROJECT_PRODUCTION_URL cobre
# o caso comum; defina esta só para domínio próprio. Ver lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# ──────────────────────────────── Banco ────────────────────────────────────
# Postgres (Neon). Sem esta variável o site usa o armazenamento em memória —
# que some a cada instância e NÃO serve em produção. Ver docs/BANCO.md.
#
# Na Vercel, a integração do Neon (Marketplace → Neon → Connect Project) cria
# esta variável sozinha, em Production, Preview e Development. Localmente,
# copie a connection string do painel do Neon:
#
#   postgresql://<usuario>:<senha>@<host>.neon.tech/<banco>?sslmode=require
#
DATABASE_URL=

# Nome antigo, do tempo do Vercel Postgres. Só é lido se DATABASE_URL faltar —
# está aqui para não quebrar projeto criado antes da migração para o Neon.
# POSTGRES_URL=
